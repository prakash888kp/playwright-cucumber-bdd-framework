# ---------- Global defaults (overridden by config/env/.env.<ENV> and by CLI) ----------
ENV=qa
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=true
PARALLEL=2
RETRY=0
# TAGS: e.g. @smoke, "@ui and not @wip" — used by run mode 2 (env-driven)
TAGS=
DEFAULT_TIMEOUT=30000
TRACE=on-failure          # on | off | on-failure
VIDEO=off                 # on | off
STEP_SCREENSHOTS=on       # on | failure | off — per-step screenshots in the report (UI scenarios)
LOG_LEVEL=info

# ---------- AWS / Bedrock (RAG validation) ----------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from your shell or AWS profile — never commit them
# BEDROCK_KB_ID: Bedrock Knowledge Base ID for retrieveAndGenerate
BEDROCK_KB_ID=
BEDROCK_RAG_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_JUDGE_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
RAG_MIN_KEYWORD_COVERAGE=0.6
RAG_MIN_JUDGE_SCORE=7
