{
  "name": "playwright-cucumber-bdd-framework",
  "version": "1.0.0",
  "description": "Enterprise Playwright + Cucumber BDD framework — UI, API and RAG (Amazon Bedrock) validation with Excel-driven execution",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/run.js",
    "test:excel": "node src/runners/excelRunner.js",
    "test:env": "node scripts/run.js",
    "test:smoke": "node scripts/run.js --profile smoke",
    "test:regression": "node scripts/run.js --profile regression",
    "test:ui": "node scripts/run.js --profile ui",
    "test:api": "node scripts/run.js --profile api",
    "test:rag": "node scripts/run.js --profile rag",
    "test:rerun": "node scripts/run.js --profile rerun",
    "test:dev": "cross-env ENV=dev node scripts/run.js",
    "test:qa": "cross-env ENV=qa node scripts/run.js",
    "test:prod": "cross-env ENV=prod node scripts/run.js --profile smoke",
    "test:headed": "cross-env HEADLESS=false node scripts/run.js",
    "report": "node scripts/generateReport.js",
    "generate:excel": "node scripts/generateExcels.js",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "api-testing",
    "rag",
    "bedrock"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1086.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1086.0",
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.61.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.6",
    "multiple-cucumber-html-reporter": "^4.1.0",
    "playwright": "^1.61.1",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
